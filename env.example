# ─── Primary Database: Oracle Autonomous Database ───────────────────────────
DATABASE_URL=oracle+oracledb://KBO_APP@TNS_ALIAS
ORACLE_APP_USER=KBO_APP
ORACLE_APP_PASSWORD=
TNS_ADMIN=/secure/path/to/oracle-wallet
ORACLE_WALLET_HOST_PATH=/secure/path/to/oracle-wallet
OCI_WALLET_PASSWORD=

# ─── Disposable Oracle verification target (never production) ────────────────
OCI_DB_URL=oracle+oracledb://ADMIN@TNS_ALIAS
KBO_RUN_OCI_INTEGRATION=0

# ─── SQLite source for one-time Oracle initial load ──────────────────────────
SQLITE_SOURCE_URL=sqlite:///./data/kbo_dev.db
ORACLE_TARGET_URL=

# ─── Local PostgreSQL service (optional development profile) ────────────────
POSTGRES_DB=kbo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kbo_dev

# ─── pgvector (optional local acceptance only; not production) ───────────────
# PGVECTOR_URL is intentionally unset for the Oracle production path.
PGVECTOR_PASSWORD=kbo_rag_dev

# ─── KBO Official Site Authentication ───────────────────────────────────────
KBO_USER_ID=
KBO_USER_PWD=

# ─── Request Throttling ──────────────────────────────────────────────────────
KBO_REQUEST_DELAY_MIN=2.0

# ─── External API Keys ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BEGA_PROD_PASSWORD=

# ─── RAG Embeddings (OpenRouter) ────────────────────────────────────────────
OPENROUTER_API_KEY=

# RAG uses the same Oracle database for source, sparse, and native VECTOR rows.
# Set RAG_SOURCE_DB_URL only when the read-only source is separate.
RAG_SOURCE_DB_URL=
# Leave RAG_INDEX_DB_URL empty for the single Oracle store.
RAG_INDEX_DB_URL=
RAG_TARGET_ENV=staging
RAG_INDEX_ALLOW_WRITE=0
RAG_INDEX_ALLOW_PRODUCTION_WRITE=0
RAG_EMBED_BATCH_SIZE=50
RAG_INDEX_VERSION=rag-v1
RAG_CHUNKING_VERSION=rag-v1
# EMBEDDING_MODEL: OpenRouter embedding model (default perplexity/pplx-embed-v1-4b, 1536차원)
EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b

# ─── Notifications ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Default/ops-group chat used when no per-source chat is configured.
TELEGRAM_CHAT_ID=
# Optional per-source routing (fall back to TELEGRAM_CHAT_ID when empty).
# Legacy gap categories:
TELEGRAM_CHAT_ID_P0=
TELEGRAM_CHAT_ID_STALENESS=
TELEGRAM_CHAT_ID_RELAY=
TELEGRAM_CHAT_ID_STANDINGS=
TELEGRAM_CHAT_ID_PROFILE=
TELEGRAM_CHAT_ID_FRESHNESS=
TELEGRAM_CHAT_ID_ID_RESOLUTION=
TELEGRAM_CHAT_ID_PA_FORMULA=
TELEGRAM_CHAT_ID_TEAM_STATS=
# Alert sources (incident pipeline):
TELEGRAM_CHAT_ID_DATABASE=
TELEGRAM_CHAT_ID_CRAWLER=
TELEGRAM_CHAT_ID_INTEGRITY=
TELEGRAM_CHAT_ID_QUALITY=
TELEGRAM_CHAT_ID_DRIFT=
TELEGRAM_CHAT_ID_RAG=
TELEGRAM_CHAT_ID_RECOVERY=
TELEGRAM_CHAT_ID_SCHEDULER=
TELEGRAM_CHAT_ID_PIPELINE=
TELEGRAM_CHAT_ID_REPORT=
TELEGRAM_CHAT_ID_SYSTEM=
SLACK_WEBHOOK_URL=
# Generic JSON webhook (NotificationChannel.WEBHOOK).
ALERT_WEBHOOK_URL=

# ─── Alert policy ───────────────────────────────────────────────────────────
# Delivery floor: INFO incidents are recorded but not sent below WARNING.
ALERT_MIN_SEVERITY=WARNING
# Global kill-switch for scheduled alert delivery (state still updates).
ALERT_DRY_RUN=0
# Delivery retry and cooldown tuning.
ALERT_DELIVERY_ATTEMPTS=3
ALERT_DELIVERY_BACKOFF_SECONDS=0.5
ALERT_COOLDOWN_INFO_SECONDS=21600
ALERT_COOLDOWN_WARNING_SECONDS=1800
ALERT_COOLDOWN_ERROR_SECONDS=600
ALERT_COOLDOWN_CRITICAL_SECONDS=300

# ─── Data integrity gate ─────────────────────────────────────────────────────
# Days with no KBO games are normal (rest days, All-Star break, Nov-Feb off-season),
# so check_games_exist passes vacuously on an empty date. Set this to 1 once an
# authoritative schedule is available to turn a missing date back into a failure.
INTEGRITY_EXPECT_GAMES=0
# Days re-evaluated by the scheduled integrity job so a transient failure can
# resolve its own incident. Bounded to 7.
INTEGRITY_RECHECK_LOOKBACK_DAYS=2

# ─── Migration safety ────────────────────────────────────────────────────────
# Database names treated as production by apply_postgres_migrations. A schema
# write to one of these on a non-loopback host is refused unless --allow-prod is
# passed. Loopback targets are always considered local. Blank = built-in default.
KBO_PROD_DB_NAMES=bega_prod

# ─── Observability (Sentry & Prometheus) ────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PROMETHEUS_PORT=8000
