# ─── Primary Database: Oracle Autonomous Database ───────────────────────────
DATABASE_URL=oracle+oracledb://USER:PASSWORD@TNS_ALIAS
TNS_ADMIN=/secure/path/to/oracle-wallet
ORACLE_WALLET_HOST_PATH=/secure/path/to/oracle-wallet
OCI_WALLET_PASSWORD=

# ─── SQLite source for one-time Oracle initial load ──────────────────────────
SQLITE_SOURCE_URL=sqlite:///./data/kbo_dev.db
ORACLE_TARGET_URL=

# ─── Local PostgreSQL service (optional development profile) ────────────────
POSTGRES_DB=kbo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=kbo_dev

# ─── pgvector (RAG 임베딩 DB) ────────────────────────────────────────────────
PGVECTOR_URL=postgresql://postgres:kbo_rag_dev@localhost:5433/kbo_rag
PGVECTOR_PASSWORD=kbo_rag_dev

# ─── KBO Official Site Authentication ───────────────────────────────────────
KBO_USER_ID=
KBO_USER_PWD=

# ─── Request Throttling ──────────────────────────────────────────────────────
KBO_REQUEST_DELAY_MIN=2.0

# ─── External API Keys ──────────────────────────────────────────────────────
YOUTUBE_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── RAG Embeddings (OpenRouter or Google AI Studio) ────────────────────────
# OpenRouter_API_KEY: OpenRouter key (sk-or-v1-...) or Google AI Studio key (AIza...)
OpenRouter_API_KEY=
# EMBEDDING_MODEL: OpenRouter embedding model (default perplexity/pplx-embed-v1-4b, 1536차원)
EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b

# ─── Notifications ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID_RELAY=
TELEGRAM_CHAT_ID_STANDINGS=
TELEGRAM_CHAT_ID_PROFILE=
TELEGRAM_CHAT_ID_FRESHNESS=
SLACK_WEBHOOK_URL=

# ─── Observability (Sentry & Prometheus) ────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
PROMETHEUS_PORT=8000
