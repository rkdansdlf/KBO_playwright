# KBO Text Relay Crawler - Playwright 최적화 Dockerfile
# 베이스 이미지: python:3.14-slim + Playwright Chromium 직접 설치.
#
# Microsoft 공식 Playwright 이미지(mcr.microsoft.com/playwright/python)는 Python
# 3.12에 고정돼 있고 3.14 변형을 배포하지 않는다. pyproject.toml의
# `requires-python = ">=3.14"`와 맞지 않으면 `uv pip install .`이 불일치로
# 빌드를 거부하므로 베이스를 바꾼다. 브라우저와 시스템 라이브러리가 갈라지지
# 않도록 `playwright install --with-deps`가 둘을 함께 설치한다.
#
# 빌드: docker build -f Dockerfile.playwright -t kbo-text-relay .
# 실행: docker run --rm -v $(pwd)/data:/app/data kbo-text-relay --game-id 20260412SKLG0 --save

FROM python:3.14-slim

# 환경 변수 설정
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 업데이트 및 필수 도구 설치
# (Playwright 베이스 이미지에 대부분 포함되어 있으나, 추가 도구 설치)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        jq \
        gosu \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 의존성 파일 복사 및 설치 (Docker 캐시 최적화)
# pyproject.toml이 변경되지 않으면 이 레이어는 캐시됨
COPY pyproject.toml README.md ./
COPY src/ ./src/
RUN uv pip install --system --no-cache . && rm -rf /app/src

# Chromium과 그 런타임 라이브러리. `--with-deps`가 이 베이스 이미지에 맞는 apt
# 목록을 계산하므로, 이전에는 Microsoft 베이스 이미지가 암묵적으로 제공하던
# 라이브러리를 브라우저 빌드와 같은 출처에서 맞춘다.
RUN python -m playwright install --with-deps chromium && \
    chmod -R a+rX /ms-playwright

# 소스코드 복사
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY Docs/ ./Docs/
COPY migrations/ ./migrations/
COPY docker/ ./docker/
COPY pyproject.toml ./

# 출력 디렉토리 생성 및 볼륨 마운트 포인트 설정
RUN mkdir -p /app/data /app/logs && \
    chmod -R 755 /app/data /app/logs

# 비루트 사용자 생성 및 전환
RUN groupadd -r appuser && \
    useradd -r -g appuser -d /app -s /bin/bash appuser && \
    chown -R appuser:appuser /app && \
    chmod -R u+rwX,go+rX /app

# 볼륨 마운트 포인트 선언
# 호스트의 ./data를 컨테이너의 /app/data에 바인드 마운트하여
# 크롤링 데이터가 호스트에 즉시 저장되도록 함
VOLUME ["/app/data", "/app/logs"]

# entrypoint.sh starts as root, adjusts volume ownership, then drops
# to appuser via gosu.  This USER directive is intentionally omitted
# so that the entrypoint can perform the initial chown.  The actual
# process runs as appuser after gosu exec.
# USER appuser  -- see docker/entrypoint.sh for privilege-drop logic

# 헬스체크 (선택사항)
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import pandas; import playwright; print('OK')" || exit 1

# 기본 실행 명령어
ENTRYPOINT ["bash", "docker/entrypoint.sh"]
CMD ["python", "-m", "src.cli.crawl_text_relay", "--help"]
