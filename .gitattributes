# Auto detect text files and perform LF normalization
* text=auto
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Captured pages. `* text=auto` classifies these as text but leaves the line
# endings to whatever the server sent, so a CRLF response lands in the index
# as CRLF and the working copy then differs from what was committed. That is
# what the trailing-whitespace and end-of-file hooks were fixing, twice, on two
# different fixtures.
*.html text eol=lf
*.sh text eol=lf
# Byte-sensitive test fixtures (sha256-verified at runtime): never convert line endings
tests/fixtures/** text eol=lf
